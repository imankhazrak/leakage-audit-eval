Bootstrap: docker
From: node:20-bookworm-slim

# Runtime for the LeakageDetector 2.0 Linux native bundle (Prompt 8B-8D,
# Stage 0). The bundle is a PyInstaller build linked against glibc 2.35;
# the cluster (RHEL 9, glibc 2.34) cannot load it natively, so it is executed
# inside this Debian 12 (glibc 2.36) image. The bundle itself is *not*
# baked into the image: it is downloaded by scripts/fetch_leakage_detector_bundle.sh
# into tools/leakage_detector/ and bind-mounted at /opt/ld at run time so the
# recorded SHA-256 in configs/phase9/static_tools.yaml stays authoritative.
#
# The compiled Datalog executable (_internal/leakage_algo_linux) needs
# libgomp. The customised Pyright the bundle ships resolves pandas /
# scikit-learn symbols through the `python` on PATH, exactly as the upstream
# leakage-analysis Dockerfile does with its /venv; the same four libraries
# are installed here with pinned versions.

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        libgomp1 python3 python3-venv python3-pip ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /venv
    /venv/bin/pip install --no-cache-dir --upgrade pip==24.0
    /venv/bin/pip install --no-cache-dir \
        numpy==1.24.4 \
        pandas==2.0.3 \
        scikit-learn==1.3.2 \
        imbalanced-learn==0.11.0
    mkdir -p /work /opt/ld

%environment
    export PATH=/venv/bin:/usr/local/bin:/usr/bin:/bin
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1

%labels
    org.leakagelens.purpose "LeakageDetector 2.0 native bundle runtime"
    org.leakagelens.phase "phase9 static tools"

%help
    Build (login node, lightweight):
        apptainer build --fakeroot tools/containers/leakage_detector_runtime.sif \
            containers/leakage_detector_runtime.def
    Run one analysis (bundle at tools/leakage_detector/bundle/main):
        apptainer exec --cleanenv --bind <workdir>:/work \
            --bind tools/leakage_detector/bundle/main:/opt/ld --pwd /work \
            tools/containers/leakage_detector_runtime.sif /opt/ld/main /work/pipeline.py -o
